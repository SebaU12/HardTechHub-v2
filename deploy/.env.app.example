# Copiar a .env.app en cada VM de aplicación y completar con valores reales.
# NUNCA comitear .env.app al repositorio.
# El valor de DB_HOST es la IP privada de la VM de datos (Output DataPrivateIP del stack).

# ── Red: host de la VM de datos ───────────────────────────────────────────
DB_HOST=10.0.20.XXX

# ── Credenciales de aplicación (escritura) ────────────────────────────────
POSTGRES_USER=hardtech
POSTGRES_PASSWORD=CHANGE_ME_POSTGRES

MYSQL_USER=hardtech
MYSQL_PASSWORD=CHANGE_ME_MYSQL

MONGO_APP_USER=hardtech
MONGO_APP_PASSWORD=CHANGE_ME_MONGO_APP

# ── Credenciales de solo lectura (ingestores) ─────────────────────────────
POSTGRES_READER_USER=hardtech_reader
POSTGRES_READER_PASSWORD=CHANGE_ME_POSTGRES_READER

MYSQL_READER_USER=hardtech_reader
MYSQL_READER_PASSWORD=CHANGE_ME_MYSQL_READER

MONGO_READER_USER=hardtech_reader
MONGO_READER_PASSWORD=CHANGE_ME_MONGO_READER

# ── AWS (sin claves estáticas — se usa el rol de instancia EC2) ───────────
AWS_DEFAULT_REGION=us-east-1
S3_BUCKET=hardtech-datalake

# ── Athena ────────────────────────────────────────────────────────────────
ANALYTICS_BACKEND=athena
ATHENA_DATABASE=hardtech_analytics
ATHENA_WORKGROUP=hardtech-workgroup

# ── Swagger: URL base pública para "Try it out" ──────────────────────────
# Completar con el output ApiEndpoint del stack CloudFormation.
# Dejar vacío para pruebas locales (Swagger UI usará la URL relativa del host).
API_BASE_URL=

# ── Identificador de instancia (se establece en setup-app-ec2.sh) ─────────
# INSTANCE_ID se inyecta automáticamente desde los metadatos EC2.
# No modificar aquí; el script lo escribe en este archivo al iniciar.
INSTANCE_ID=
